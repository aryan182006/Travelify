# ─────────────────────────────────────────────────────────
#  Travelify — Environment Variables
#  Copy this file to  .env  and fill in your real values.
#  NEVER commit .env to git — add it to .gitignore!
# ─────────────────────────────────────────────────────────

# Flask secret key — change this to any long random string
SECRET_KEY=change-this-to-a-long-random-secret-string-2026

# ── Gmail Email Settings ──────────────────────────────────
# Use a Gmail App Password (NOT your normal password)
# How to get one:
#   1. myaccount.google.com → Security
#   2. Enable 2-Step Verification
#   3. App Passwords → Create → Copy the 16-char key
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxxxxxxxxxxxxxxxxxx
MAIL_DEFAULT_SENDER=your_gmail@gmail.com

# ── Google Maps API Key ───────────────────────────────────
# Get from: console.cloud.google.com
#   → APIs & Services → Library → Enable "Maps JavaScript API"
#   → Credentials → Create API Key
# Leave blank to use the OpenStreetMap fallback instead.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
